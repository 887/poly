{
  "defaultMode": "bypassPermissions",
  "enableAllProjectMcpServers": true,
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "additionalDirectories": ["/tmp"],
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "MultiEdit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "mcp__poly-electron",
      "mcp__poly-desktop",
      "mcp__poly-web",
      "mcp__poly-memory",
      "mcp__chrome-devtools",
      "mcp__chrome-devtools-headless"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "find .claude/worktrees -maxdepth 1 -name 'agent-*' -mtime +1 2>/dev/null | while read wt; do id=$(basename \"$wt\"); jj workspace forget \"$id\" 2>/dev/null; rm -rf \"$wt\"; done; exit 0"
          }
        ]
      }
    ]
  }
}
